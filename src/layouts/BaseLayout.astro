---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Notice from '../components/Notice.astro';
import { getImage } from 'astro:assets';
import { pool } from '../data/pool';
import sharePhoto from '../assets/photos/hero-home.jpg';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
// The home page title already starts with the pool's name.
const fullTitle = title.startsWith(pool.name) ? title : `${title} | ${pool.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Preview image for links shared on Facebook, in texts, and in search results.
const share = await getImage({ src: sharePhoto, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const shareUrl = new URL(share.src, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b6690" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={pool.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A child swimming at Wendwood Pool" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400..800;1,400&family=Shrikhand&display=swap" />
    <script is:inline async defer src="https://citadel.dadalorian.com/stardust" data-website-id="72dd6bc7-e75e-461f-b26c-2f8dbbb873c1" data-performance="true"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {pool.notice && <Notice>{pool.notice}</Notice>}
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
