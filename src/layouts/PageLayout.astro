---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  // Big title text, when it differs from the browser-tab title.
  heading?: string;
  // A sentence or two under the title.
  lead?: string;
  // Photo beside the title. Omit for text pages (rules, privacy).
  photo?: ImageMetadata;
  photoAlt?: string;
}
const { title, description, heading = title, lead, photo, photoAlt = '' } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <header class:list={['page-head', { 'has-photo': photo }]}>
    <div class="wrap page-head-inner">
      <div>
        <h1>{heading}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot name="head" />
      </div>
      {photo && <Image src={photo} alt={photoAlt} widths={[400, 700, 1000]} sizes="(max-width: 760px) 100vw, 480px" loading="eager" />}
    </div>
  </header>
  <div class="lane" aria-hidden="true"></div>
  <div class="wrap page-body">
    <slot />
  </div>
  <slot name="full" />
</BaseLayout>
