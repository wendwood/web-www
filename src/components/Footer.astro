---
import { pool } from '../data/pool';
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <a href={`mailto:${pool.email}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5h20v14H2zm2 2v.5l8 5 8-5V7zm0 2.9V17h16V9.9l-8 5z"/></svg>
      Email us
    </a>
    <a href={pool.mapUrl}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
      {pool.address}
    </a>
    <a href={pool.facebook}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h18v18h-6v-7h2.5l.5-3H15V9.5c0-.9.4-1.5 1.6-1.5H18V5.3A21 21 0 0 0 15.6 5C13.2 5 12 6.4 12 8.8V11H9.5v3H12v7H3z"/></svg>
      Follow us!
    </a>
  </div>
  <p class="wrap footer-links"><a href="/privacy/">Privacy</a> · <a href="/events/">Events</a> · <a href="/pool-rules/">Pool rules</a></p>
</footer>
