---
import { pool } from '../data/pool';
---
<footer class="site-footer">
  <div class="lane" aria-hidden="true"></div>
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <img src="/logo.png" alt="Wendwood Association" width="200" height="61" />
      <p>{pool.name} is run by the {pool.association} for the neighborhood.</p>
    </div>
    <div>
      <h2>Visit</h2>
      <p><a href={pool.mapUrl}>{pool.addressLines[0]}<br />{pool.addressLines[1]}</a></p>
    </div>
    <div>
      <h2>Get in touch</h2>
      <p><a href={`mailto:${pool.email}`}>{pool.email}</a></p>
      <p>Pool phone {pool.poolPhone}<br /><span class="muted">Emergencies only</span></p>
    </div>
    <div>
      <h2>Follow</h2>
      <p><a href={pool.facebook}>Facebook</a></p>
      <p><a href={pool.swimTeam}>Wendwood Wahoos</a></p>
    </div>
  </div>
  <p class="wrap footer-links"><a href="/pool-rules/">Pool rules</a><a href="/events/">Events</a><a href="/privacy/">Privacy</a></p>
</footer>
