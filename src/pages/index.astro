---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BusinessInfo from '../components/BusinessInfo.astro';
import Hours from '../components/Hours.astro';
import { pool } from '../data/pool';
import hero from '../assets/photos/hero-home.jpg';
import lifeguard from '../assets/photos/home-lifeguard.jpg';
import party from '../assets/photos/home-party.jpg';
import swimTeam from '../assets/photos/home-swim-team.jpg';
import lessons from '../assets/photos/home-lessons.jpg';
import float from '../assets/photos/band-float.jpg';

const p = pool.prices;
const card = { widths: [400, 700], sizes: '(max-width: 760px) 100vw, 360px' };
---
<BaseLayout title={`${pool.name} | Neighborhood Pool in Newport News, VA`} description="Wendwood Pool is a members-only neighborhood pool in Newport News, VA, with a splash pad, pool parties, and the Wendwood Wahoos swim team.">
  <BusinessInfo slot="head" />
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1>Wendwood Pool</h1>
        <p class="lead">A shady oasis tucked in a quiet Newport News neighborhood. Bring a book and relax on our pool deck.</p>
        <p class="actions">
          <a class="button" href="/membership/">Become a member</a>
          <a class="button alt" href="#hours">See pool hours</a>
        </p>
      </div>
      <Image class="hero-photo" src={hero} alt="A girl in star sunglasses and armbands swimming" widths={[800, 1200, 1600]} sizes="(max-width: 760px) 100vw, 60vw" loading="eager" />
    </div>
  </section>
  <div class="lane" aria-hidden="true"></div>

  <div class="wrap">
    <div class="home-hours" id="hours">
      <Hours />
      <section class="visit-note">
        <h2>Visiting without a membership?</h2>
        <p>Our pool insurance covers members and their guests, so we can't sell day passes.</p>
        <p>Come as a member's guest instead: local guests are ${p.localGuestDay} a day, and guests from more than 50 miles away swim free.</p>
        <p><a href="/pool-rules/">Guest rules and passes</a></p>
      </section>
    </div>

    <section class="split welcome">
      <div>
        <h2>Welcome to our pool</h2>
        <p>Wendwood is a 4-lane, 25-yard neighborhood pool and home of the Wendwood Wahoos swim team. A Red Cross certified lifeguard is always on duty.</p>
        <p>One third of the pool is 3 feet or less, with plenty of room for young minnows. The middle third is a little deeper, perfect for hours of pool games, and in the deep end cannonballs off the diving board happen daily. A separate, fenced splash pad lets the littlest swimmers play away from the big kids.</p>
        <p>The deck has umbrella tables and plenty of reclining chairs for sunbathing, and free Wi-Fi if you need to work while the kids splash.</p>
        <p><a class="button" href="/membership/">Join us</a></p>
      </div>
      <Image src={lifeguard} alt="Lifeguard stand and pool deck with umbrellas" widths={[400, 700]} sizes="(max-width: 760px) 100vw, 520px" />
    </section>

    <div class="trio">
      <section>
        <Image src={party} alt="A birthday treat at a pool party" {...card} />
        <h2>Book a pool party</h2>
        <p>Make a splash at your next celebration with the pool, the deck, and the grounds to yourselves.</p>
        <p><a href="/parties/">Party times and prices</a></p>
      </section>
      <section>
        <Image src={swimTeam} alt="A Wahoos swimmer doing breaststroke" {...card} />
        <h2>Swim with the Wahoos</h2>
        <p>The Wendwood Wahoos are small but mighty. We work hard, learn proper technique, cheer on our teammates, and have fun.</p>
        <p><a href={pool.swimTeam}>Wahoos website</a></p>
      </section>
      <section>
        <Image src={lessons} alt="A young swimmer with a kickboard" {...card} />
        <h2>Learn to swim</h2>
        <p>We hope to have a staff member offer lessons in 2026. We'll share the details here when they're ready.</p>
      </section>
    </div>
  </div>

  <section class="association">
    <Image src={float} alt="" widths={[800, 1600, 2200]} sizes="100vw" />
    <div class="wrap">
      <div class="association-box">
        <h2>Not here for the pool?</h2>
        <p>The {pool.association} looks after the whole neighborhood. Help keep Wendwood beautiful and join Association events with an I Support Wendwood membership for ${p.supportWendwood}.</p>
        <p><a class="button" href={pool.membershipSignup}>Support Wendwood</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
