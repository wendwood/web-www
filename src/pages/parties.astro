---
import PageLayout from '../layouts/PageLayout.astro';
import { pool } from '../data/pool';
import partyPhoto from '../assets/photos/home-party.jpg';

const party = pool.parties;
---
<PageLayout
  title="Parties"
  heading="Pool parties"
  description={`Members can rent Wendwood Pool in Newport News for a private party: $${pool.parties.pricePerHour} an hour with ${pool.parties.lifeguards} lifeguards and up to ${pool.parties.maxGuests} guests.`}
  lead="Adding water to any celebration makes it more fun. Host your summer party at Wendwood Pool."
  photo={partyPhoto}
  photoAlt="A birthday treat at a pool party"
>
  <p class="members-only">Our insurance lets us rent the pool for private parties to members only.</p>

  <div class="split party">
    <section>
      <h2>Party times</h2>
      <dl class="fee-list">
        {party.slots.map((s) => <div><dt>{s.days}</dt><dd>{s.time}</dd></div>)}
      </dl>
    </section>
    <section>
      <h2>What's included</h2>
      <ul class="checks">
        <li>${party.pricePerHour} per hour</li>
        <li>{party.lifeguards} lifeguards</li>
        <li>Up to {party.maxGuests} guests</li>
      </ul>
      <p>A ${party.deposit} deposit holds your date.</p>
    </section>
  </div>

  {!party.bookingOpen && (
    <p class="notice-box">Online party booking is closed for now. It reopens before the pool season starts.</p>
  )}

  <section class="ask">
    <h2>Questions about hosting a party?</h2>
    <p><a class="button" href={`mailto:${pool.email}?subject=Pool%20party%20question`}>Email us</a></p>
  </section>
</PageLayout>
