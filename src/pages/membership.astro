---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import Gallery from '../components/Gallery.astro';
import Hours from '../components/Hours.astro';
import { pool } from '../data/pool';
import basketball from '../assets/photos/membership-basketball.jpg';
import drink from '../assets/photos/membership-drink.jpg';

const p = pool.prices;
---
<PageLayout
  title="Membership"
  description={`${pool.season} Wendwood Pool memberships for households, singles, and seniors in Newport News, VA, with prices, volunteer discounts, and summer hours.`}
  lead="Sunbathe on our reclining chairs, read a book in the shade, or float on a giant unicorn. Littles play in the fenced splash pool while Red Cross certified lifeguards watch the big pool, and free Wi-Fi lets parents telework poolside."
  photo={basketball}
  photoAlt="Pool basketball"
>
  <section class="prices" aria-labelledby="prices-title">
    <h2 id="prices-title">{pool.season} memberships</h2>
    <p>Volunteer {pool.volunteerHours} hours during the season and your membership costs less.</p>
    <div class="table-scroll">
      <table class="price-table">
        <thead>
          <tr><th scope="col">Membership</th><th scope="col">With {pool.volunteerHours} volunteer hours</th><th scope="col">Without volunteer hours</th></tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Household<span>{pool.eligibility.household}</span></th>
            <td data-label={`With ${pool.volunteerHours} volunteer hours`}>${p.household.volunteer}</td>
            <td data-label="Without volunteer hours">${p.household.noVolunteer}</td>
          </tr>
          <tr>
            <th scope="row">Single or senior<span>{pool.eligibility.single}, {pool.season}</span></th>
            <td data-label={`With ${pool.volunteerHours} volunteer hours`}>${p.single.volunteer}</td>
            <td data-label="Without volunteer hours">${p.single.noVolunteer}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <ul class="checks">
      <li>Use of the pool all season</li>
      <li>{pool.guestPassesIncluded} guest passes</li>
      <li>All Association-sponsored activities</li>
      <li>Free Wi-Fi at the pool</li>
    </ul>
    <p class="callout">New to the neighborhood since April 1, {pool.season - 1}? Take ${p.newNeighborDiscount} off your membership.</p>
    <p class="actions">
      <a class="button" href={pool.membershipSignup}>Sign up online</a>
      <a class="button alt" href="/pool-rules/">{pool.season} pool rules</a>
    </p>
    <p class="small">Paying by cash or check? Fill out the online form and choose “Check” as the payment option.</p>
  </section>

  <section class="split support">
    <Image src={drink} alt="A treat from the snack shack" widths={[400, 700, 1000]} sizes="(max-width: 760px) 100vw, 520px" />
    <div class="support-box">
      <h2>I Support Wendwood</h2>
      <p class="price">${p.supportWendwood}</p>
      <p>Don't need the pool? Help keep Wendwood beautiful with neighborhood landscaping projects, and join any Association-sponsored activity outside the pool.</p>
      <p><a class="button" href={pool.membershipSignup}>Join the Association</a></p>
    </div>
  </section>

  <section class="extras" aria-labelledby="extras-title">
    <h2 id="extras-title">Guests and add-ons</h2>
    <dl class="fee-list">
      <div><dt>Guest add-on</dt><dd>${p.guestAddOn} each</dd></div>
      <div><dt>Guest passes</dt><dd>${p.guestPass} each, or ${p.guestPass12} for 12</dd></div>
      <div><dt>Local guests</dt><dd>${p.localGuestDay} per guest per day</dd></div>
      <div><dt>Guests from 50+ miles away</dt><dd>Free</dd></div>
    </dl>
    <p class="small">Every guest must come with a current member. <a href="/pool-rules/">How guests work</a></p>
  </section>

  <Hours />

  <Gallery slot="full" />
</PageLayout>
