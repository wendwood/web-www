---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import { pool } from '../data/pool';
import basketball from '../assets/photos/membership-basketball.jpg';
import drink from '../assets/photos/membership-drink.jpg';

const p = pool.prices;
const square = { widths: [400, 700], sizes: '(max-width: 640px) 100vw, 510px' };
---
<PageLayout title="Membership" pre="at the" description={`${pool.season} Wendwood Pool memberships, prices, and hours.`}>
  <div class="split">
    <div>
      <p>The Wendwood Pool has so much to offer our members. Free Wi-Fi allows parents to telework as the kids splash and play while our American Red Cross certified lifeguards keep them safe. Sunbathe on our reclining chairs, read a book in the shade, or float on a giant unicorn! Littles can safely play in our completely fenced-in splash pool while parents supervise nearby.</p>
    </div>
    <Image src={basketball} alt="Pool basketball" {...square} />
  </div>

  <div class="split">
    <Image src={drink} alt="A treat from the snack shack" {...square} />
    <section class="panel">
      <h2 class="label">{pool.season} Memberships</h2>
      <h3>Household</h3>
      <p>+{pool.volunteerHours} volunteer hours: ${p.household.volunteer}<br />no volunteer hours: ${p.household.noVolunteer}</p>
      <h3>Single/Senior</h3>
      <p>+{pool.volunteerHours} volunteer hours: ${p.single.volunteer}<br />no volunteer hours: ${p.single.noVolunteer}</p>
      <ul>
        <li>Includes use of the pool all season</li>
        <li>Participation in all Association-sponsored activities</li>
        <li>FREE Wi-Fi at the pool!</li>
      </ul>
      <p><a class="button pink" href="/pool-rules/">{pool.season} Pool rules</a></p>
      <p class="callout">New to the neighborhood? Get ${p.newNeighborDiscount} off your membership fee!</p>
      <a class="button pink" href={pool.membershipSignup}>Sign up today</a>
    </section>
  </div>

  <section class="strip orange strip-row">
    <div>
      <h3>I SUPPORT WENDWOOD MEMBERSHIP</h3>
      <p>Want to help keep Wendwood beautiful and take part in Association-sponsored events, but don't need pool privileges? Support us for ${p.supportWendwood}.</p>
    </div>
    <a class="button white" href={pool.membershipSignup}>Join us today</a>
  </section>

  <section class="strip magenta">
    <h3 class="center">Anticipated {pool.season} Pool Hours</h3>
    <div class="hours-cols">
      {pool.hours.map((h) => <div>{h.days}: {h.time}</div>)}
    </div>
    <p class="fine">Hours may change because of swim team events, attendance, scheduled parties, and staffing. We always aim to be open as many hours as we can.</p>
  </section>

  <section class="section-blue strip">
    <h2>Want to pay with cash or check?</h2>
    <p>Fill out the online form and choose "Check" as the payment option.</p>
    <a class="button white" href={pool.membershipSignup}>Online form (preferred)</a>
  </section>
</PageLayout>
