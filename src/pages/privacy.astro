---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const entry = await getEntry('pages', 'privacy');
if (!entry) throw new Error('src/content/pages/privacy.md is missing');
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
---
<PageLayout title={entry.data.title} header="bar" banner={false} white wide description={entry.data.description}>
  <p>Effective date: {fmt.format(entry.data.updated)}</p>
  <Content />
  <div slot="full" class="blue-strip"></div>
</PageLayout>
