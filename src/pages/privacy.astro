---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const entry = await getEntry('pages', 'privacy');
if (!entry) throw new Error('src/content/pages/privacy.md is missing');
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
---
<PageLayout title={entry.data.title} description={entry.data.description}>
  <div class="panel"><p class="fine">Last updated {fmt.format(entry.data.updated)}</p>
  <Content /></div>
</PageLayout>
