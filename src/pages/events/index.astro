---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const events = (await getCollection('events')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<PageLayout title="Events" description="Events and fundraisers from Wendwood Pool and the Wendwood Association in Newport News, VA." lead="Fundraisers and get-togethers that keep the pool going.">
  <ul class="event-list">
    {events.map((e) => (
      <li>
        <p class="small">{fmt.format(e.data.date)}</p>
        <h2><a href={e.data.page ?? `/events/${e.id}/`}>{e.data.title}</a></h2>
        <p>{e.data.summary}</p>
      </li>
    ))}
  </ul>
</PageLayout>
