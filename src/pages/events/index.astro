---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const events = (await getCollection('events')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<PageLayout title="Events" pre="at the" description="Events and fundraisers from Wendwood Pool and the Wendwood Association in Newport News, VA.">
  <div class="panel"><ul>
    {events.map((e) => (
      <li><a href={e.data.page ?? `/events/${e.id}/`}>{e.data.title}</a> ({fmt.format(e.data.date)}): {e.data.summary}</li>
    ))}
  </ul></div>
</PageLayout>
