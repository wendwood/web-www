---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const events = (await getCollection('events')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<PageLayout title="Events and Fundraisers" kicker="Around the Wendwood Pool" description="Wendwood Pool events and fundraisers.">
  <ul>
    {events.map((e) => (
      <li><a href={`/${e.id}/`}>{e.data.title}</a> ({fmt.format(e.data.date)}): {e.data.summary}</li>
    ))}
  </ul>
</PageLayout>
