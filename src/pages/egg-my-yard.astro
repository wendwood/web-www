---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { pool } from '../data/pool';

const entry = await getEntry('events', 'egg-my-yard');
if (!entry) throw new Error('src/content/events/egg-my-yard.md is missing');
const { Content } = await render(entry);
---
<PageLayout title={entry.data.title} pre="support the" description={entry.data.summary}>
  <div class="panel"><Content />
  {entry.data.paymentLink
    ? <p><a class="button" href={entry.data.paymentLink}>Order now</a></p>
    : <p><strong>Orders aren't open right now.</strong> Questions? Email <a href={`mailto:${pool.email}`}>{pool.email}</a>.</p>}
</div></PageLayout>
