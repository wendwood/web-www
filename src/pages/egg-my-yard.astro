---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import Gallery from '../components/Gallery.astro';
import easter from '../assets/photos/banner-easter.png';

const entry = await getEntry('events', 'egg-my-yard');
if (!entry) throw new Error('src/content/events/egg-my-yard.md is missing');
const { Content } = await render(entry);
---
<PageLayout title={entry.data.title} pre="support the" banner={easter} description={entry.data.summary}>
  <div class="split">
    <div class="event-body"><Content /></div>
    <div>
      <section class="order-box">
        <h3>Egg Quantity</h3>
        {entry.data.paymentLink
          ? <a class="button pink" href={entry.data.paymentLink}>Order now</a>
          : <p>Orders aren't open right now. Check back before Easter!</p>}
      </section>
      <Image src={easter} alt="Easter bunny and chicks with eggs" widths={[400, 700]} sizes="(max-width: 640px) 100vw, 510px" />
    </div>
  </div>
  <Gallery slot="full" />
</PageLayout>
