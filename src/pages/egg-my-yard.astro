---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Gallery from '../components/Gallery.astro';
import easter from '../assets/photos/banner-easter.png';

const entry = await getEntry('events', 'egg-my-yard');
if (!entry) throw new Error('src/content/events/egg-my-yard.md is missing');
const { Content } = await render(entry);
---
<PageLayout title={entry.data.title} description={entry.data.summary} lead={entry.data.summary} photo={easter} photoAlt="Easter bunny and chicks with eggs">
  <div class="split event">
    <div class="prose"><Content /></div>
    <aside class="order-box">
      <h2>Order eggs</h2>
      {entry.data.paymentLink
        ? <a class="button" href={entry.data.paymentLink}>Order now</a>
        : <p>Orders aren't open right now. Check back before Easter!</p>}
    </aside>
  </div>
  <Gallery slot="full" />
</PageLayout>
