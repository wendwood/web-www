---
import PageLayout from '../layouts/PageLayout.astro';
import { pool, address } from '../data/pool';
import entrance from '../assets/photos/contact-entrance.jpg';
---
<PageLayout
  title="Contact"
  heading="Contact us"
  description={`Contact Wendwood Pool in Newport News, VA, by email or Facebook, with directions to the pool at ${pool.addressLines[0]}`}
  lead="We want to hear from you. Email is the best way to reach us."
  photo={entrance}
  photoAlt="The pool entrance"
>
  <dl class="fee-list contact-list">
    <div><dt>Email</dt><dd><a href={`mailto:${pool.email}`}>{pool.email}</a></dd></div>
    <div><dt>Facebook</dt><dd><a href={pool.facebook}>facebook.com/wendwood.pool</a></dd></div>
    <div><dt>Address</dt><dd><a href={pool.mapUrl}>{address}</a></dd></div>
    <div><dt>Pool phone</dt><dd>{pool.poolPhone}, for emergencies only</dd></div>
  </dl>
  <p><a class="button" href={`mailto:${pool.email}`}>Email us</a></p>
</PageLayout>
